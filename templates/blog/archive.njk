<section class="archive-intro" aria-labelledby="blog-title">
  <p class="blog-eyebrow">From the workbench</p>
  <h1 id="blog-title">{{ blog.title | escape }}</h1>
  <p>{{ blog.description | escape }}</p>
</section>
<div class="post-list">
{% for post in pagination.items %}
  <article class="post-preview">
    <div class="post-meta"><time datetime="{{ post.data.isoDate }}">{{ post.data.dateLabel }}</time><span aria-hidden="true">/</span><span>{{ post.data.minutes }} min read</span>{% if post.data.draft %}<span class="draft-label">Draft</span>{% endif %}</div>
    <h2><a href="{{ post.url }}">{{ post.data.title | escape }} <span aria-hidden="true">↗</span></a></h2>
    <p>{{ post.data.summary | escape }}</p>
    {% if post.data.tags.length %}<ul class="post-tags" aria-label="Topics">{% for tag in post.data.tags %}<li>{{ tag | escape }}</li>{% endfor %}</ul>{% endif %}
  </article>
{% else %}
  <p class="blog-empty">Posts are on the way.</p>
{% endfor %}
</div>
{% if pagination.pages.length > 1 %}
<nav class="blog-pagination" aria-label="Blog pages">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Newer posts</a>{% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older posts →</a>{% endif %}
</nav>
{% endif %}
